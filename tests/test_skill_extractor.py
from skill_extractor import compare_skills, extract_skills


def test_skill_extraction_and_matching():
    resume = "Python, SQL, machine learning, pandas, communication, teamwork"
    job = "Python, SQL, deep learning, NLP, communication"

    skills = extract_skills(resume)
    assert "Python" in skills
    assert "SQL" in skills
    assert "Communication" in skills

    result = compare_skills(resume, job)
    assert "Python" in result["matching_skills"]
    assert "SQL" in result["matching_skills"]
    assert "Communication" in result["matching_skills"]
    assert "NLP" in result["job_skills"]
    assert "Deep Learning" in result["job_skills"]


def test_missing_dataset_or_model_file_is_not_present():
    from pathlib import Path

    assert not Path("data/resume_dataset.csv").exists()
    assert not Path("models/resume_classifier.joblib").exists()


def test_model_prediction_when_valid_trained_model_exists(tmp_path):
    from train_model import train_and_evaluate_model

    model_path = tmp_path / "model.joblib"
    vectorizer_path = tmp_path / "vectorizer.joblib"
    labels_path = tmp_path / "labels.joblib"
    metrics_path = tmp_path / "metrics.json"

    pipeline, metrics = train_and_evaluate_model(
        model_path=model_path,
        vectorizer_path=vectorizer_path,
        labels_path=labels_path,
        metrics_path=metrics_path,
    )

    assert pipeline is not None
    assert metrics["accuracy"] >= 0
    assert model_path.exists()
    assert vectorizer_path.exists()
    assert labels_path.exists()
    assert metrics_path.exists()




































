tests/test_matcher.py
from matcher import compute_similarity_score


def test_empty_job_description():
    assert compute_similarity_score("Python developer with SQL", "") == 0.0


def test_normal_text_similarity():
    text_a = "Python developer skilled in SQL, pandas, and machine learning"
    text_b = "Python developer skilled in SQL, pandas, and machine learning"
    score = compute_similarity_score(text_a, text_b)
    assert score > 90


def test_dissimilar_text_similarity():
    text_a = "Python developer with SQL and ML"
    text_b = "Chef specializing in cooking and food service"
    score = compute_similarity_score(text_a, text_b)
    assert score < 50




































